@@ -0,0 +1,26 @@
+#ifndef DC_HUMAN_NAVIGATOR_POLICY_H
+#define DC_HUMAN_NAVIGATOR_POLICY_H
+
+#include <string>
+
+namespace DcHumanNavigator
+{
+inline bool EncounterSupport(std::string const& name)
+{
+    return name == "dungeon clear run event combat" || name == "dungeon clear hold fire" ||
+        name == "dungeon clear hor stay ahead" || name == "dungeon clear oc rider" ||
+        name == "dungeon clear razorgore orb" || name == "dungeon clear razorgore camp";
+}
+
+inline bool SuppressRouteAction(std::string const& name, bool combat)
+{
+    bool const dc = name.compare(0, 13, "dungeon clear") == 0;
+    if (combat)
+        return dc && !EncounterSupport(name);
+    return name == "attack anything" || name == "pull start" || name == "pull action" ||
+        name == "reach pull" || (dc && (name.find("engage") != std::string::npos ||
+        name.find("pull") != std::string::npos || name.find("room clear") != std::string::npos ||
+        name.find("assist") != std::string::npos || name.find("stalled") != std::string::npos));
+}
+}
+#endif

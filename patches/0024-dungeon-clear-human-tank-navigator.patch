diff --git a/modules/mod-dungeon-clear/src/Ai/Dungeon/DungeonClear/Util/DcHumanNavigator.h b/modules/mod-dungeon-clear/src/Ai/Dungeon/DungeonClear/Util/DcHumanNavigator.h

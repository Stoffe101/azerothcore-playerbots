@@ -0,0 +1,101 @@
+#ifndef DC_HUMAN_NAVIGATOR_H
+#define DC_HUMAN_NAVIGATOR_H
+
+#include "Creature.h"
+#include "Group.h"
+#include "Player.h"
+#include "Map.h"
+#include "Playerbots.h"
+#include "PlayerbotAI.h"
+#include "Ai/Dungeon/DungeonClear/DcValueKeys.h"
+#include "Ai/Dungeon/DungeonClear/Util/DcRun.h"
+#include "DcHumanNavigatorPolicy.h"
+
+#include <algorithm>
+#include <string>
+
+namespace DcHumanNavigator
+{
+// A dead bot tank still owns its normal recovery path. Only human-only tank groups
+// elect a non-tank navigator; no combat role, master or group-leader flag is changed.
+inline Player* HumanTank(Player* reference)
+{
+    if (!reference || !reference->GetGroup() || !reference->GetMap() || !reference->GetMap()->IsDungeon())
+        return nullptr;
+    Player* human = nullptr;
+    for (GroupReference* ref = reference->GetGroup()->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        if (!member || member->GetMap() != reference->GetMap() || !PlayerbotAI::IsTank(member))
+            continue;
+        if (!IsRealPlayer(member))
+            return nullptr;
+        if (!human || member->GetGUID() < human->GetGUID())
+            human = member;
+    }
+    return human;
+}
+
+inline Player* Navigator(Player* reference)
+{
+    if (!HumanTank(reference))
+        return nullptr;
+    Player* navigator = nullptr;
+    for (GroupReference* ref = reference->GetGroup()->GetFirstMember(); ref; ref = ref->next())
+    {
+        Player* member = ref->GetSource();
+        if (!member || member->GetMap() != reference->GetMap() || !member->IsAlive() ||
+            IsRealPlayer(member) || !GET_PLAYERBOT_AI(member))
+            continue;
+        if (!navigator || (PlayerbotAI::IsHeal(navigator) && !PlayerbotAI::IsHeal(member)) ||
+            (PlayerbotAI::IsHeal(navigator) == PlayerbotAI::IsHeal(member) && member->GetGUID() < navigator->GetGUID()))
+            navigator = member;
+    }
+    return navigator;
+}
+
+inline bool PartyInCombat(Player* bot)
+{
+    if (!bot || !bot->GetGroup())
+        return false;
+    for (GroupReference* ref = bot->GetGroup()->GetFirstMember(); ref; ref = ref->next())
+        if (Player* member = ref->GetSource())
+            if (member->GetMap() == bot->GetMap() && member->IsInCombat())
+                return true;
+    return false;
+}
+
+inline bool Active(Player* bot)
+{
+    Player* navigator = Navigator(bot);
+    PlayerbotAI* ai = navigator ? GET_PLAYERBOT_AI(navigator) : nullptr;
+    return ai && DcRun::Of(ai).enabled && !DcRun::Of(ai).paused;
+}
+
+inline bool SafeDestination(PlayerbotAI* ai, float x, float y, float z)
+{
+    Player* bot = ai ? ai->GetBot() : nullptr;
+    Player* human = HumanTank(bot);
+    if (!human)
+        return true;
+    if (!human->IsAlive() || PartyInCombat(bot) || human->GetDistance(x, y, z) > 12.0f)
+        return false;
+    // Check every spline point, not only its endpoint, before allowing the guide
+    // to move. The human owns all pulls; the navigator stops outside aggro range.
+    for (ObjectGuid guid : ai->GetAiObjectContext()->GetValue<GuidVector>(DcKey::Stock::PossibleTargets)->Get())
+        if (Unit* unit = ai->GetUnit(guid))
+            if (Creature* creature = unit->ToCreature())
+                if (creature->IsAlive() && creature->IsHostileTo(bot) &&
+                    creature->GetDistance(x, y, z) < std::max(30.0f, creature->GetAttackDistance(bot) + 8.0f))
+                    return false;
+    return true;
+}
+
+inline bool SuppressAction(Player* bot, std::string const& name, bool combat)
+{
+    if (!Active(bot))
+        return false;
+    return SuppressRouteAction(name, combat || PartyInCombat(bot));
+}
+}
+#endif

     std::mutex g_pendingMutex;   // Detect/FlushCombat run per-player inside Map::Update — maps
                                  // tick in parallel, so this shared map needs the same locking
                                  // as the era caches (prod rehash-race segfault, 2026-08-26)
+
+    // resetTalents(true) fires PlayerScript::OnPlayerTalentsReset even when the reset is an
+    // INTERNAL cleanup of Blizzard's native talent maps. On a plain managed-era relog,
+    // StripNativeTalents can find a leaked/stale native talent and call ResetAllSpecs while
+    // valid era_character_talent rows already exist. Without a guard, the talent-reset hook
+    // mistakes that cleanup for a user/GM respec and deletes the entire custom era build.
+    //
+    // The re-entry is synchronous on the same thread. Keep this thread_local because players
+    // on different maps can run transition checks in parallel.
+    thread_local uint32 g_internalTalentResetDepth = 0;
+
+    class InternalTalentResetScope
+    {
+    public:
+        InternalTalentResetScope() { ++g_internalTalentResetDepth; }
+        ~InternalTalentResetScope() { --g_internalTalentResetDepth; }
+        InternalTalentResetScope(InternalTalentResetScope const&) = delete;
+        InternalTalentResetScope& operator=(InternalTalentResetScope const&) = delete;
+    };
 }
 
 namespace EraTransition
 {
+    bool IsInternalTalentReset()
+    {
+        return g_internalTalentResetDepth != 0;
+    }

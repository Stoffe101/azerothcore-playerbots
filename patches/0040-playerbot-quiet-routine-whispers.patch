+void UseItemAction::TellConsumableUse(Item* item, std::string const action, float percent)
+{
+    // Food/drink telemetry is intentionally silent for the same reason as weapon imbues.
+    (void)item;
+    (void)action;
+    (void)percent;
 }
 

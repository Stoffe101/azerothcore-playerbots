+uint32 RandomPlayerbotMgr::ScaleDownRandomBots(uint32 target)
+{
+    uint32 const selected = static_cast<uint32>(currentBots.size());
+    uint32 const online = static_cast<uint32>(playerBots.size());
+    uint32 const excess = std::max(selected, online) > target ? std::max(selected, online) - target : 0;
+    uint32 const limit = std::min<uint32>(std::max<uint32>(1, sPlayerbotAIConfig.randomBotsPerInterval), excess);
+    if (!limit)
+        return 0;
+
+    uint32 removed = 0;
+    uint32 protectedCount = 0;
+    std::vector<uint32> candidates(currentBots.begin(), currentBots.end());
+    for (uint32 botId : candidates)
+    {
+        if (removed >= limit)
+            break;
+
+        ObjectGuid const guid = ObjectGuid::Create<HighGuid::Player>(botId);
+        if (botLoading.contains(guid))
+        {
+            ++protectedCount;
+            continue;
+        }
+
+        uint32 const accountId = sCharacterCache->GetCharacterAccountIdByGuid(guid);
+        if (!accountId || std::find(rndBotTypeAccounts.begin(), rndBotTypeAccounts.end(), accountId) == rndBotTypeAccounts.end())
+        {
+            LOG_ERROR("playerbots", "Population scale-down refused non-RNDbot candidate {} account {}", botId, accountId);
+            ++protectedCount;
+            continue;
+        }
+
+        Player* bot = GetPlayerBot(guid);
+        if (IsProtectedFromPopulationRemoval(guid, bot))
+        {
+            ++protectedCount;
+            continue;
+        }
+
+        SetEventValue(botId, "add", 0, 0);
+        currentBots.erase(botId);
+        if (bot)
+            LogoutPlayerBot(guid);
+        ++removed;
+    }
+
+    if (removed || protectedCount)
+        LOG_INFO("playerbots", "Population scale-down target={} removed={} deferredProtected={} selected={} online={}",
+                 target, removed, protectedCount, selected, online);
+    return removed;
 }
 

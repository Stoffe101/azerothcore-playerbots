+RandomPlayerbotFactory::CapacityProvisionStatus RandomPlayerbotFactory::ProvisionRandomBotCapacityStep(
+    uint32 maxAccountsPerStep)
+{
+    CapacityProvisionStatus status;
+    status.requiredAccounts = CalculateTotalAccountCount();
+    maxAccountsPerStep = std::max<uint32>(1, maxAccountsPerStep);
+
+    std::unordered_map<std::string, uint32> existingByName;
+    QueryResult accounts = LoginDatabase.Query(
+        "SELECT id, username FROM account WHERE username LIKE '{}%%' ORDER BY id",
+        sPlayerbotAIConfig.randomBotAccountPrefix.c_str());
+    if (accounts)
+    {
+        do
+        {
+            Field* fields = accounts->Fetch();
+            existingByName.emplace(fields[1].Get<std::string>(), fields[0].Get<uint32>());
+        } while (accounts->NextRow());
+    }
+
+    std::vector<uint32> expectedAccounts;
+    std::vector<std::string> missingAccounts;
+    expectedAccounts.reserve(status.requiredAccounts);
+    for (uint32 accountNumber = 0; accountNumber < status.requiredAccounts; ++accountNumber)
+    {
+        std::string accountName = RandomBotAccountName(accountNumber);
+        auto const account = existingByName.find(accountName);
+        if (account == existingByName.end())
+            missingAccounts.push_back(std::move(accountName));
+        else
+            expectedAccounts.push_back(account->second);
+    }
+
+    status.existingAccounts = static_cast<uint32>(expectedAccounts.size());
+    sPlayerbotAIConfig.randomBotAccounts = expectedAccounts;
+
+    std::unordered_map<uint32, uint32> characterCounts;
+    if (!expectedAccounts.empty())
+    {
+        std::string accountList;
+        for (uint32 accountId : expectedAccounts)
+        {
+            if (!accountList.empty())
+                accountList += ',';
+            accountList += std::to_string(accountId);
+        }
+
+        QueryResult characters = CharacterDatabase.Query(
+            "SELECT account, COUNT(*) FROM characters WHERE account IN ({}) GROUP BY account", accountList);
+        if (characters)
+        {
+            do
+            {
+                Field* fields = characters->Fetch();
+                characterCounts[fields[0].Get<uint32>()] = static_cast<uint32>(fields[1].Get<uint64>());
+            } while (characters->NextRow());
+        }
+    }
+
+    std::vector<uint32> incompleteAccounts;
+    for (uint32 accountId : expectedAccounts)
+    {
+        uint32 count = characterCounts[accountId];
+        status.existingCharacters += count;
+        if (count < 10)
+            incompleteAccounts.push_back(accountId);
+    }
+
+    bool const loginBusy = LoginDatabase.QueueSize() != 0;
+    bool const characterBusy = CharacterDatabase.QueueSize() != 0;
+    status.waitingForDatabase = loginBusy || characterBusy;
+
+    if (!loginBusy)
+    {
+        uint32 queued = 0;
+        for (std::string const& accountName : missingAccounts)
+        {
+            if (queued >= maxAccountsPerStep)
+                break;
+
+            std::string password = accountName;
+            if (sPlayerbotAIConfig.randomBotRandomPassword)
+            {
+                password.clear();
+                for (uint8 index = 0; index < 10; ++index)
+                    password += static_cast<char>(urand('!', 'z'));
+            }
+
+            if (sAccountMgr->CreateAccount(accountName, password) == AOR_OK)
+            {
+                ++queued;
+                ++status.accountsQueued;
+            }
+        }
+    }
+
+    if (!characterBusy && !incompleteAccounts.empty())
+    {
+        RandomBotNameCache nameCache;
+        if (LoadAvailableRandomBotNames(nameCache))
+        {
+            uint32 populated = 0;
+            for (uint32 accountId : incompleteAccounts)
+            {
+                if (populated >= maxAccountsPerStep)
+                    break;
+                status.charactersQueued += CreateMissingCharacters(accountId, nameCache);
+                ++populated;
+            }
+        }
+    }
+
+    status.complete = missingAccounts.empty() && incompleteAccounts.empty() &&
+        !status.accountsQueued && !status.charactersQueued && !status.waitingForDatabase;
+    return status;
 }
 

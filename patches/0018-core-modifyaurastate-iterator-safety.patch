+            // ModifyAuraState can nest. Only built on an actual state transition, so this is
+            // not a per-proc cost.
+            std::vector<Aura*> snapshot;
+            snapshot.reserve(GetOwnedAuras().size());
+            for (auto const& pair : GetOwnedAuras())
+                snapshot.push_back(pair.second);
+
+            for (Aura* aura : snapshot)
             {
-                if ((*itr).second->IsRemoved())

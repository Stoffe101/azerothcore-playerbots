# The AzerothCore fork + modules are cloned by setup.sh on the server.
azerothcore-wotlk/

# Client addons are fetched by fetch-client-addons.sh; client-dist/ is the folder
# it drops client-addons.zip into (folder-mounted read-only into ac-webreg, so a
# rebuilt zip is served live without recreating the container).
client-addons/
client-dist/
client-addons.zip

# Database backups produced by backup.sh.
backups/

# Local env / secrets
.env
.env.pre-restore
*.local

# Compiled ac-webreg binary (built into a container by setup.sh on the server)
webreg/acore-webreg

# Python sidecar: local virtualenv and bytecode cache
lore-sidecar/.venv/
**/__pycache__/
*.pyc

# Typed Group Composer UI toolchain
client-ui/node_modules/
client-ui/dist/

# ERA-07 downloads pinned historical DB snapshots into a local cache.
.cache/era-item-provenance/

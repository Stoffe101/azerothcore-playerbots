[worldserver]

########################################
# mod-raid-roster configuration
########################################

# RaidRoster.Enable
#   Master switch. Default 0. setup.sh sets this from .env RAIDROSTER_ENABLE.
RaidRoster.Enable = 0

########################################
# Adventure start (this fork)
########################################

# AdventureStart.Enable
#   Bootstrap newly-created REAL player characters for the TBC-first experience.
#   Random bots / addclass bots / playerbots are excluded.
AdventureStart.Enable = 1

# AdventureStart.Level
#   Starting character level. 60 puts the player at the beginning of Outland progression.
AdventureStart.Level = 60

# AdventureStart.Progression
#   Individual Progression stage. 8 = Vanilla completed / beginning of TBC.
#   Valid range 0-18.
AdventureStart.Progression = 8

# AdventureStart.RevealMap
#   Reveal all world-map exploration tiles on the player's first login.
#   This removes fog-of-war but does not teleport the player or unlock flight paths.
AdventureStart.RevealMap = 1

########################################
# Guild Group Director (this fork)
########################################

# GuildDirector.Enable
#   Watch REAL-player guild chat for deterministic dungeon requests such as
#   "anyone up for Ramparts?" and form a balanced 5-player party from the persistent roster.
#   The text parser is deterministic; the LLM is not used to decide grouping intent.
GuildDirector.Enable = 1

# GuildDirector.AutoTravel
#   After the four roster bots are online and synced, move the party to the registered exterior
#   entrance using the same Adventure Travel backend as `.adventure go`.
GuildDirector.AutoTravel = 1

# GuildDirector.ReadyTimeoutMs
#   Give asynchronous playerbot logins this long to finish before cancelling the request.
#   Clamped to 5000-60000 ms.
GuildDirector.ReadyTimeoutMs = 15000

########################################
# Encounter lifecycle (this fork)
########################################

# EncounterLifecycle.Enable
#   Master switch for wipe recovery / automatic preparation helpers. These helpers never
#   auto-pull or replace Playerbots combat decision making.
EncounterLifecycle.Enable = 1

# WipeRecovery.Enable
#   Detect a true full-party wipe inside a dungeon/raid and schedule one recovery pass.
WipeRecovery.Enable = 1

# WipeRecovery.DelayMs
#   Wait this long after the full wipe before recovery. Clamped to 2000-30000 ms.
WipeRecovery.DelayMs = 5000

# WipeRecovery.ResurrectHumans
#   When enabled, real players are resurrected together with the guild bots after a full wipe.
#   Disable this if you prefer manual human corpse runs while still recovering bots.
WipeRecovery.ResurrectHumans = 1

# AutoPrep.Enable
#   Ask existing Playerbots non-combat AI to run a preparation pass after instance entry and
#   after automatic wipe recovery. This does not invent class spell logic in this module.
AutoPrep.Enable = 1

# AutoPrep.WarlockSupport
#   Warlock bots prepare healthstone/soulstone support and prefer a healer soulstone strategy.
AutoPrep.WarlockSupport = 1

# AutoPrep.SmartPets
#   Let hunter/warlock class AI immediately reevaluate its normal pet state during preparation.
AutoPrep.SmartPets = 1

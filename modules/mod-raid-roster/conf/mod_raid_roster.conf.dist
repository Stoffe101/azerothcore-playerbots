[worldserver]

########################################
# mod-raid-roster configuration
########################################

# RaidRoster.Enable
#   Master switch. Default 0. setup.sh sets this from .env RAIDROSTER_ENABLE.
RaidRoster.Enable = 0

########################################
# Adventure start (this fork)
########################################
AdventureStart.Enable = 1
AdventureStart.Level = 60
AdventureStart.Progression = 8
AdventureStart.RevealMap = 1

########################################
# Guild Group Director (this fork)
########################################
GuildDirector.Enable = 1
GuildDirector.AutoTravel = 1
GuildDirector.ReadyTimeoutMs = 15000

########################################
# Smart guild loot (this fork)
########################################

# SmartLoot.Enable
#   Enable the fair-guild loot policy. This uses Playerbots' existing item-usage evaluator rather
#   than inventing a second gear scorer for bot rolls.
SmartLoot.Enable = 1

# SmartLoot.BotNeedUpgrades
#   Let bots roll NEED when Playerbots classifies an item as an actual equip/replace upgrade.
#   When disabled, those decisions are downgraded to GREED as in upstream's conservative default.
SmartLoot.BotNeedUpgrades = 1

# SmartLoot.BotGreedUseful
#   Let bots GREED useful non-upgrades, BoEs/vendor/AH items, etc. Unusable items remain PASS.
SmartLoot.BotGreedUseful = 1

# BadLuckProtection.Enable
#   Persist dry boss streaks for real players. A meaningful spec upgrade won shortly after that
#   boss resets the streak. The streak is used by the later personal-loot protection engine.
BadLuckProtection.Enable = 1

# BadLuckProtection.UpgradeWindowSeconds
#   Associate a meaningful group-roll gear win with the most recent credited boss on this map for
#   this many seconds. Clamped to 30-600 seconds.
BadLuckProtection.UpgradeWindowSeconds = 120

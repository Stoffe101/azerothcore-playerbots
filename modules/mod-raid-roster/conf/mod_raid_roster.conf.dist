[worldserver]

########################################
# mod-raid-roster configuration
########################################

# RaidRoster.Enable
#   Master switch. Default 0. setup.sh sets this from .env RAIDROSTER_ENABLE.
RaidRoster.Enable = 0

########################################
# Adventure start (this fork)
########################################

# AdventureStart.Enable
#   Bootstrap newly-created REAL player characters for the TBC-first experience.
#   Random bots / addclass bots / playerbots are excluded. Death Knights are also excluded
#   because they belong to the WotLK stage-13 start flow.
AdventureStart.Enable = 1

# AdventureStart.Level
#   Starting character level. 60 puts the player at the beginning of Outland progression.
AdventureStart.Level = 60

# AdventureStart.Progression
#   Individual Progression stage. 8 = Vanilla completed / beginning of TBC.
#   Valid range 0-18.
AdventureStart.Progression = 8

# AdventureStart.RevealMap
#   Reveal all world-map exploration tiles on the player's first login.
AdventureStart.RevealMap = 1

# AdventureStart.StarterKit
#   Gives real players their level-appropriate class skills/spells, bags, ammo where relevant,
#   food, combat potions and fast-ground Riding. Professions and flying are intentionally excluded.
AdventureStart.StarterKit = 1

# AdventureStart.StartingGold
#   Minimum money after the starter kit. Existing money is never reduced.
AdventureStart.StartingGold = 50

# AdventureStart.BasicGear / BasicGearItemLevel
#   Immediately equip a modest green set while the custom EraTalents tree has no committed spec.
#   This temporary set is replaced by the raider set once enough talent points are spent.
AdventureStart.BasicGear = 1
AdventureStart.BasicGearItemLevel = 58

# AdventureStart.AutoGear
#   Once the player commits enough points to one of the custom TBC talent trees, replace the basic
#   set once with a complete Playerbots-scored EPIC set appropriate to that spec.
AdventureStart.AutoGear = 1

# AdventureStart.GearMinTalentPoints
#   Number of total era-talent points required before choosing the spec-aware raider set.
AdventureStart.GearMinTalentPoints = 5

# AdventureStart.GearItemLevel
#   Power target for the one-time epic set. ilvl 88 models a successful late-Vanilla AQ40/Naxx40
#   raider entering Outland: excellent starting gear that should still be replaced through TBC.
#   Selection is spec/era aware, but is intentionally not hard-coded to exact named raid drops.
AdventureStart.GearItemLevel = 88

# AdventureStart.Teleport.Enable
#   Teleport the fresh TBC character to the Blasted Lands side of the Dark Portal after
#   level/progression initialization. This only runs from the first-login hook.
AdventureStart.Teleport.Enable = 1

# AdventureStart.Teleport.Map / X / Y / Z / O
#   Configurable first-login destination. Defaults are The Dark Portal in Blasted Lands.
#   If you later choose a nicer exact standing position, use .gps in-game and replace these
#   values; no code change is required.
AdventureStart.Teleport.Map = 0
AdventureStart.Teleport.X = -11894.80
AdventureStart.Teleport.Y = -3206.52
AdventureStart.Teleport.Z = -14.62
AdventureStart.Teleport.O = 0.0
